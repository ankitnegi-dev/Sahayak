# ParentBot environment template.
#
# Copy to .env and fill in real values. NEVER commit .env, it is in .gitignore.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | staging | production
# In production, all secrets below become mandatory and config.Load fails fast
# if any are missing.
APP_ENV=development

# LOG_LEVEL overrides the environment default: debug | info | warn | error
# LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Local (docker compose): postgres://parentbot:parentbot@localhost:5432/parentbot?sslmode=disable
# Hosted (Neon/Supabase): use the connection string from the provider dashboard.
DATABASE_URL=postgres://parentbot:parentbot@localhost:5432/parentbot?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------------------------------------------------------------------------
# Redis (asynq broker)
# ---------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# WhatsApp Cloud API  (https://developers.facebook.com → WhatsApp → API Setup)
# ---------------------------------------------------------------------------
# Access token from the WhatsApp > API Setup panel. Temporary tokens expire in
# 24h; use a System User token for anything longer-lived.
WHATSAPP_ACCESS_TOKEN=
# The token you choose when creating the webhook. Any value works locally;
# Meta echoes it back during the GET verification handshake.
WHATSAPP_VERIFY_TOKEN=
# App Secret from App Settings > Basic. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Phone Number ID of the test number.
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Anthropic (conversation engine, Phase 5)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Speech to text (Phase 3)
#
# One provider is enough at a time. Which one wins is decided by the ASR
# benchmark, not by guessing: record 30 to 50 voice notes from your parents,
# hand-write the correct transcripts, then run
#   go run ./cmd/asrbench -manifest corpus/manifest.jsonl -provider sarvam
# and compare. See corpus/manifest.example.jsonl for the format.
# ---------------------------------------------------------------------------
# Sarvam, from https://sarvam.ai. Strongest option for Hindi and Hinglish.
# Sent as the api-subscription-key header, not a bearer token.
SARVAM_API_KEY=

# OpenAI Whisper, from https://platform.openai.com
OPENAI_API_KEY=

# Google Cloud Speech-to-Text, from the Google Cloud console
GOOGLE_STT_API_KEY=

# BCP-47 language code passed to the provider. "hi-IN" is the closest match
# for Hinglish; "en-IN" is the alternative worth benchmarking against.
ASR_LANGUAGE=hi-IN

# Biasing terms sent to the provider as keyterms or a prompt. Family place
# names are exactly what a general model mishears, so this list matters:
#   ASR_KEYTERMS=Mandir,Railway Station,New Delhi
ASR_KEYTERMS=

# Transcripts below this confidence trigger an ask-to-repeat reply rather
# than a guess. Note that Sarvam and Whisper report no per-utterance
# confidence at all, so for them this only gates the length heuristic.
ASR_MIN_CONFIDENCE=0.6

# ffmpeg executable path. Empty means "ffmpeg" on PATH.
FFMPEG_PATH=
